# Gatepath Realtors — Local Development Secrets
# Copy this to .dev.vars and fill in your real values.
# NEVER commit .dev.vars to Git.

# Supabase (get from: https://app.supabase.com → Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role — server-only, bypasses RLS entirely. NEVER prefix
# with VITE_ (that ships it to every visitor's browser). Only ever read
# inside a server function handler — see src/lib/adminActions.ts and
# docs/SECURITY_HARDENING.md. In production this goes in Cloudflare's
# Variables and Secrets as an ENCRYPTED secret, not a plain variable.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Paystack (get from: https://dashboard.paystack.com → Settings → API Keys)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack SECRET key — server-only, same NEVER-VITE_-prefix rule as the
# Supabase service role above. Used to re-verify every payment directly
# against Paystack's API before anything is written to the database — see
# src/lib/paymentActions.ts and docs/SECURITY_HARDENING.md (CRITIQUE P0-2).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# When going live, replace pk_test_/sk_test_ with pk_live_/sk_live_
